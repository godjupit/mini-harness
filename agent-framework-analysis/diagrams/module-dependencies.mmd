flowchart LR
    user([用户 / 库调用者])

    subgraph Entry[用户入口]
        cli[CLI composition root<br/>mini-oh / cli._run]
        api[Library API<br/>AgentLoop.run]
        tracecli[Trace CLI<br/>list / show / replay]
    end

    subgraph Core[核心运行模块]
        loop[AgentLoop<br/>运行编排]
        toolcore[Tool capability boundary<br/>Registry + effect scheduling]
    end

    subgraph Domain[领域协议]
        models[Message / ToolCall<br/>ModelReply / AgentEvent]
    end

    subgraph Control[扩展与横切控制]
        hooks[Lifecycle Hooks<br/>Verification Gate]
        perms[PermissionPolicy<br/>human approval]
        context[ContextCompactor<br/>ArtifactStore]
        trace[TraceWriter / TraceStore<br/>redaction + replay]
    end

    subgraph Adapters[能力适配器]
        providers[Streaming Providers<br/>Responses / Chat / Demo]
        local[Local file tools]
        skills[SkillCatalog<br/>LoadSkillTool]
        mcp[MCP bridge<br/>stdio / HTTP / OAuth]
        docker[DockerSandbox<br/>sandbox_shell]
    end

    subgraph External[外部系统 / 存储]
        modelsvc[(OpenAI / compatible API)]
        workspace[(Workspace files)]
        mcpserver[(MCP servers)]
        dockerdaemon[(Docker daemon)]
        stores[(JSONL traces / artifacts<br/>OAuth token files)]
        hookproc[(Trusted hook process)]
    end

    user -->|调用| cli
    user -->|直接调用| api
    user -->|查询记录| tracecli
    cli -->|创建| api
    api -->|启动| loop
    cli -->|组装| providers
    cli -->|注册| local
    cli -->|注册| skills
    cli -->|连接并注册| mcp
    cli -->|可选注册| docker
    cli -->|注入| hooks
    cli -->|注入| perms
    cli -->|注入| context
    cli -->|创建| trace

    loop -->|读写对话状态| models
    loop -->|调用 / 消费流事件| providers
    providers -->|转换| models
    providers -->|HTTP SSE| modelsvc

    loop -->|查询 schema/source<br/>调度并执行| toolcore
    local -->|实现 Tool Protocol| toolcore
    skills -->|实现 Tool Protocol| toolcore
    mcp -->|实现 Tool Protocol| toolcore
    docker -->|实现 Tool Protocol| toolcore
    toolcore -->|授权| perms

    loop -->|四个生命周期点| hooks
    hooks -->|可选执行| hookproc
    loop -->|压缩 / offload| context
    context -->|转换| models
    context -->|写入 artifact| stores

    loop -.->|记录| trace
    toolcore -.->|权限与工具事件| trace
    hooks -.->|Hook 事件| trace
    trace -->|写入 / 读取| stores
    tracecli -->|读取 / 渲染| trace

    local -->|读取 / 写入| workspace
    skills -->|读取 SKILL.md| workspace
    mcp -->|协议调用| mcpserver
    mcp -->|读写 OAuth token| stores
    docker -->|创建一次性容器| dockerdaemon
    docker -->|挂载| workspace

    classDef entry fill:#e8f1ff,stroke:#3769a8,color:#10243e;
    classDef core fill:#ffe8c2,stroke:#a86400,color:#3b2600;
    classDef domain fill:#e5f5e0,stroke:#4d8b42,color:#153513;
    classDef control fill:#f2e8ff,stroke:#7851a9,color:#2d1745;
    classDef adapter fill:#fff3cd,stroke:#aa8500,color:#3d3100;
    classDef external fill:#eeeeee,stroke:#666666,color:#222222;
    class cli,api,tracecli entry;
    class loop,toolcore core;
    class models domain;
    class hooks,perms,context,trace control;
    class providers,local,skills,mcp,docker adapter;
    class modelsvc,workspace,mcpserver,dockerdaemon,stores,hookproc external;
