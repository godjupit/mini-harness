{
  "default": "ask",
  "rules": [
    {
      "tool": "write_file",
      "path": "secrets/*",
      "action": "deny"
    },
    {
      "tool": "write_file",
      "path": "docs/*",
      "action": "allow"
    },
    {
      "tool": "mcp__*",
      "path": "*",
      "action": "ask"
    },
    {
      "tool": "sandbox_shell",
      "command": "npm test*",
      "action": "allow"
    },
    {
      "tool": "sandbox_shell",
      "command": "npm publish*",
      "action": "deny"
    }
  ]
}
