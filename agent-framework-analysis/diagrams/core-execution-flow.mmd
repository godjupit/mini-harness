sequenceDiagram
    autonumber
    actor User as 用户
    participant CLI as cli._run
    participant Loop as AgentLoop.run
    participant Hook as HookExecutor
    participant Compact as ContextCompactor
    participant Provider as ModelProvider
    participant Lock as ResourceLockManager
    participant Registry as ToolRegistry
    participant Policy as PermissionPolicy / Approval
    participant Tool as Tool implementation
    participant Artifact as ArtifactStore
    participant Trace as TraceWriter

    User->>CLI: mini-oh [options] prompt
    CLI->>CLI: 创建 Provider / Registry / Policy / Hooks / Stores
    opt MCP configured
        CLI->>Registry: McpManager.connect_and_register(registry)
    end
    CLI->>Loop: 构造并 run(prompt)
    Loop->>Hook: user_prompt_submit({prompt})
    alt prompt Hook blocked
        Hook-->>Loop: blocked + reason
        Loop->>Trace: finish(failed)
        Loop-->>CLI: hook_blocked, error
    else prompt accepted / rewritten
        Hook-->>Loop: payload(prompt)
        Loop->>Loop: append Message(user)

        loop step = 1..max_steps
            Loop->>Compact: compact(messages, force=false)
            opt threshold exceeded and old units exist
                Compact-->>Loop: system + summary + recent atomic units
                Loop->>Trace: context_compacted
            end

            Loop->>Trace: model_request(messages, tool schemas)
            Loop->>Provider: stream(...) or complete(...)
            loop streaming events
                Provider-->>Loop: text delta / retry / complete
                Loop-->>CLI: assistant_delta / provider_retry
            end

            alt typed context-window error and retry not used
                Provider--xLoop: ProviderContextWindowError
                Loop->>Compact: compact(force=true)
                alt compacted
                    Compact-->>Loop: compacted messages
                    Loop->>Provider: retry same logical step
                else cannot compact
                    Loop-->>CLI: error
                end
            else other ProviderError
                Provider--xLoop: normalized error
                Loop->>Trace: finish(failed)
                Loop-->>CLI: error
            else ModelReply complete
                Provider-->>Loop: content + ToolCalls + usage
                Loop->>Loop: append Message(assistant)

                alt no ToolCalls
                    Loop->>Hook: stop({response, usage, cost})
                    alt stop Hook allows
                        Hook-->>Loop: allow
                        Loop->>Trace: finish(completed)
                        Loop-->>CLI: done
                    else verification blocks
                        Hook-->>Loop: blocked + reason
                        Loop->>Loop: append trusted verification feedback
                        Note over Loop: 进入下一 model step
                    end
                else one or more ToolCalls
                    Loop->>Loop: repeated-batch guard
                    alt repeated beyond limit
                        Loop->>Loop: 为每个 call 构造 loop_guard error result
                    else execute real batch
                        par each call starts concurrently
                            Loop->>Hook: pre_tool_use(call)
                            alt pre Hook blocks
                                Hook-->>Loop: error ToolResult
                            else accepted / input rewritten
                                Loop->>Registry: resources(name, rewritten args)
                                Registry-->>Loop: ResourceAccess[]
                                Loop->>Lock: acquire(resources)
                                Note over Lock: 仅冲突 read/write 等待
                                Lock-->>Loop: acquired
                                Loop->>Registry: execute(name, args, ToolContext)
                                Registry->>Registry: JSON Schema validate
                                Registry->>Policy: evaluate(effect, tool, path)
                                opt action = ask
                                    Policy-->>User: approval callback
                                    User-->>Policy: approve / deny
                                end
                                alt denied / invalid / timeout / exception
                                    Registry-->>Loop: ToolResult(is_error=true)
                                else allowed
                                    Registry->>Tool: run(args, context) with timeout
                                    Tool-->>Registry: ToolResult
                                    Registry-->>Loop: ToolResult
                                end
                                Loop->>Lock: release(resources)
                                Loop->>Hook: post_tool_use(result)
                                Hook-->>Loop: accepted / rewritten / blocked result
                            end
                        end
                    end

                    Loop->>Artifact: offload(large output)
                    Artifact-->>Loop: inline head/tail + optional path
                    Loop->>Loop: append Message(tool, same call_id)
                    Loop->>Trace: tool_end
                    Loop-->>CLI: tool_end
                    Note over Loop: 回到下一 model step
                end
            end
        end

        opt max_steps exhausted
            Loop->>Trace: finish(failed)
            Loop--xCLI: MaxStepsExceeded
        end
    end

    CLI->>CLI: close MCP manager and Provider
